/-- [frozen_mut_borrows::test_iota]:
    Source: 'tests/src/frozen-mut-borrows.rs', lines 210:0-222:1
    Visibility: public -/
def test_iota : Result Unit := do
  let decls ← alloc.vec.Vec.push (alloc.vec.Vec.new Std.U32) 7#u32
  let decls1 ← alloc.vec.Vec.push decls 2#u32
  let (r, e, iota_back) ←
    Eng.iota { t := (alloc.vec.Vec.new Std.U32), env := { decls := decls1 } }
      0#usize true
  let (b, back) ←
    match r with
    | core.result.Result.Ok o =>
      match o with
      | none => ok (false, fun e1 => (iota_back e1).t)
      | some i =>
        match i with
        | 14#uscalar => ok (true, fun e1 => (iota_back e1).t)
        | _ => ok (false, fun e1 => (iota_back e1).t)
    | core.result.Result.Err _ => ok (false, fun e1 => (iota_back e1).t)
  massert b
  let (r1, e1, iota_back1) ← Eng.iota e 1#usize true
  let (b1, back1) ←
    match r1 with
    | core.result.Result.Ok o =>
      match o with
      | none => ok (true, fun e2 => (iota_back1 e2).t)
      | some _ => ok (false, fun e2 => (iota_back1 e2).t)
    | core.result.Result.Err _ => ok (false, fun e2 => (iota_back1 e2).t)
  massert b1
  let (r2, e2, iota_back2) ← Eng.iota e1 1#usize false
  let (b2, back2) ←
    match r2 with
    | core.result.Result.Ok o =>
      match o with
      | none => ok (false, fun e3 => (iota_back2 e3).t)
      | some i =>
        match i with
        | 4#uscalar => ok (true, fun e3 => (iota_back2 e3).t)
        | _ => ok (false, fun e3 => (iota_back2 e3).t)
    | core.result.Result.Err _ => ok (false, fun e3 => (iota_back2 e3).t)
  massert b2
  let (r3, e3, iota_back3) ← Eng.iota e2 3#usize false
  let (b3, back3) ←
    match r3 with
    | core.result.Result.Ok _ => ok (false, fun e4 => (iota_back3 e4).t)
    | core.result.Result.Err i =>
      match i with
      | 0#uscalar => ok (true, fun e4 => (iota_back3 e4).t)
      | _ => ok (false, fun e4 => (iota_back3 e4).t)
  massert b3
  let v := back3 e3
  let v1 := back2 { e2 with t := v }
  let v2 := back1 { e1 with t := v1 }
  let v3 := back { e with t := v2 }
  let i := alloc.vec.Vec.len v3
  massert (i = 2#usize)
  let i1 ←
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice Std.U32) v3
      0#usize
  massert (i1 = 7#u32)
  let i2 ←
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice Std.U32) v3
      1#usize
  massert (i2 = 2#u32)

/- Unit test for [frozen_mut_borrows::test_iota] -/
#guard (test_iota).reducesTo ()

