  let b ←
    match r with
    | core.result.Result.Ok o =>
      match o with
      | none => ok false
      | some i => match i with
                  | 14#uscalar => ok true
                  | _ => ok false
    | core.result.Result.Err _ => ok false
  massert b
  massert (t = 2#usize)
  massert (s = 0#usize)
  let (r1, t1, s1) ← run_eval_iota 1#usize false true
  let b1 ←
    match r1 with
    | core.result.Result.Ok o =>
      match o with
      | none => ok false
      | some i => match i with
                  | 5#uscalar => ok true
                  | _ => ok false
    | core.result.Result.Err _ => ok false
  massert b1
  massert (t1 = 1#usize)
  massert (s1 = 4#usize)
  let (r2, t2, s2) ← run_eval_iota 1#usize true false
  let b2 ←
    match r2 with
    | core.result.Result.Ok o =>
      match o with
      | none => ok true
      | some _ => ok false
    | core.result.Result.Err _ => ok false
  massert b2
  massert (t2 = 1#usize)
  massert (s2 = 0#usize)
  let (r3, _, _) ← run_eval_iota 5#usize true false
  let b3 ←
    match r3 with
    | core.result.Result.Ok _ => ok false
    | core.result.Result.Err i =>
      match i with
      | 0#uscalar => ok true
      | _ => ok false
  massert b3

