  massert (i = 2#usize)
  let (r1, c1, _) ← generate c 2#u32 0#usize (alloc.vec.Vec.new Std.U32)
  let b1 ←
    match r1 with
    | core.result.Result.Ok b2 => if b2
                                  then ok false
                                  else ok true
    | core.result.Result.Err _ => ok false
  massert b1
  let (r2, _, _) ← generate c1 3#u32 0#usize (alloc.vec.Vec.new Std.U32)
  let b2 ←
    match r2 with
    | core.result.Result.Ok b3 => if b3
                                  then ok false
                                  else ok true
    | core.result.Result.Err _ => ok false
  massert b2

