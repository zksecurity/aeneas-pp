def test_generate : Result Unit := do
  let y ←
    lift (Std.Array.to_slice
      (Array.make 4#usize [
         Node.Pi 5#u32 1#u32, Node.Pi 1#u32 2#u32, Node.Pi 1#u32 3#u32,
         Node.Other
         ] : Array Node 4#usize))
  let ret := alloc.slice.Slice.into_vec y
  let y1 ←
    lift (Std.Array.to_slice (Array.make 1#usize [ 7#u32 ] : Array Std.U32
      1#usize))
  let ret1 := alloc.slice.Slice.into_vec y1
  let (r, c, _) ←
    generate { t := { nodes := ret }, locals := (alloc.vec.Vec.new Std.U32) }
      0#u32 1#usize ret1
  let b ←
    match r with
    | core.result.Result.Ok b1 => if b1
                                  then ok true
                                  else ok false
    | core.result.Result.Err _ => ok false
  massert b
