/-- [closures_mut_captures::test_count]:
    Source: 'tests/src/closures-mut-captures.rs', lines 113:0-119:1
    Visibility: public -/
def test_count : Result Unit := do
  let (r, e, count_back) ←
    Eng.count { t := (alloc.vec.Vec.new Std.U32), d := 0#u32 } 2#u32
  let (b, back) ←
    match r with
    | core.result.Result.Ok p =>
      let (i, b1) := p
      match i with
      | 1#uscalar =>
        if b1
        then ok (false, fun e1 => (count_back e1).t)
        else ok (true, fun e1 => (count_back e1).t)
      | _ => ok (false, fun e1 => (count_back e1).t)
    | core.result.Result.Err _ => ok (false, fun e1 => (count_back e1).t)
  massert b
  let (r1, e1, count_back1) ← Eng.count e 4#u32
  let (b1, back1) ←
    match r1 with
    | core.result.Result.Ok p =>
      let (i, b2) := p
      match i with
      | 2#uscalar =>
        if b2
        then ok (true, fun e2 => (count_back1 e2).t)
        else ok (false, fun e2 => (count_back1 e2).t)
      | _ => ok (false, fun e2 => (count_back1 e2).t)
    | core.result.Result.Err _ => ok (false, fun e2 => (count_back1 e2).t)
  massert b1
  let v := back1 e1
  let t := back { e with t := v }
  let i := alloc.vec.Vec.len t
  massert (i = 6#usize)

/- Unit test for [closures_mut_captures::test_count] -/
#guard (test_count).reducesTo ()

